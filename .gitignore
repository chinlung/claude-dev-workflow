# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Local plugin settings (per the plugin-settings .local.md pattern — may hold config/secrets)
*.local.md

# Logs
*.log

# Command output artifacts (code-audit-rigor /review-branch + /review-pr,
# multi-agent-debate /debate). Each command machine-checks its own artifact with
# git check-ignore, so a missing line here makes that command nag on every run.
review-branch-results.json
review-pr-comments.json
debate-output.json

# OS junk
.DS_Store
Thumbs.db
