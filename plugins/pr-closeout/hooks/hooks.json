{
  "description": "pr-merge-gate：gh pr merge、gh api …/pulls/<n>/merge 與 GitHub MCP 的 merge_pull_request 執行前，先跑 pr-closeout ready，exit 0 才放行；其餘一律擋下並列出原因（PR_CLOSEOUT_OK=1 可對 gh 略過一次）。不是 merge 的命令以 shell 內建比對立即放行。pr-watch-guard：有 PR 正在 pr-watch 監看時，擋下把 thread 標成已解決、在 PR 上留言、回覆或送出 review 的 Bash 命令與 GitHub MCP 工具；沒有監看時立即放行",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/pr-merge-gate.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/pr-watch-guard.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/pr-merge-gate.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*[Gg][Ii][Tt][Hh][Uu][Bb].*__.*|mcp__.*__(add_issue_comment|add_reply_to_pull_request_comment|add_comment_to_pending_review|add_pull_request_review_comment|create_pull_request_review|pull_request_review_write|submit_pending_pull_request_review|resolve_review_thread|update_issue_comment|issue_write|create_issue_comment)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/pr-watch-guard.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
