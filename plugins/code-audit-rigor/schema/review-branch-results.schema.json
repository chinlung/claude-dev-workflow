{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review-branch-results",
  "title": "Review Branch Results",
  "description": "Results from a code review of a branch, ensuring all scoped files are accounted for. Since 2.1.0 the file also carries the round's memory: which anchors were dismissed in earlier rounds (never re-posted), which verified suggestions were carried over unfixed, and whether each suggestion was introduced by this change.",
  "type": "object",
  "required": ["branch", "scopedFiles", "suggestions", "verifications"],
  "properties": {
    "branch": { "type": "string", "minLength": 1 },
    "round": { "type": "integer", "minimum": 1 },
    "scopeMode": { "type": "string", "enum": ["full", "since-last"] },
    "scopedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "status", "source"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["reviewed", "skipped"] },
          "skipReason": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["committed", "working-tree", "untracked"] },
          "blob": { "type": "string", "minLength": 1 },
          "unchangedSince": { "type": "integer", "minimum": 1 }
        },
        "if": { "properties": { "status": { "const": "skipped" } }, "required": ["status"] },
        "then": { "required": ["skipReason"] }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "quotedCode", "description", "severity", "introduced"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "quotedCode": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
          "introduced": { "type": "boolean" },
          "class": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
          "suggestion": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "dismissed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "quotedCode", "round"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "quotedCode": { "type": "string", "minLength": 1 },
          "round": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "carried": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "quotedCode", "round"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "quotedCode": { "type": "string", "minLength": 1 },
          "round": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["tier", "hits"],
      "properties": {
        "tier": { "type": "string", "enum": ["standard", "deep"] },
        "hits": { "type": "array" }
      }
    }
  }
}
