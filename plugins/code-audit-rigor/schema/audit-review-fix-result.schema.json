{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "audit-review-fix-result",
  "title": "Audit Review Fix Result",
  "description": "Final result of the audit-review-fix cycle. The validator accepts either the raw Workflow return shape (counts + applied/userReviewRequired/deferred/skipped arrays) or the normalized summary/items artifact shape. Status values mirror computeStatus() in audit-review-fix-workflow.js. Impossible-state guards are enforced by the validator.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/normalizedArtifact" },
    { "$ref": "#/definitions/workflowReturn" },
    { "$ref": "#/definitions/emptyDiffReturn" }
  ],
  "definitions": {
    "status": {
      "type": "string",
      "enum": ["CLEAN", "READY_FOR_COMMIT", "REQUIRES_USER_REVIEW", "REQUIRES_FOLLOW_UP", "TESTS_FAILED", "EMPTY_DIFF"],
      "description": "CLEAN: no active apply/review/skip/defer items (dismissed findings may exist). READY_FOR_COMMIT: all resolved, tests pass. REQUIRES_USER_REVIEW: needs human decision or skipped items. REQUIRES_FOLLOW_UP: deferred items remain. TESTS_FAILED: fixes applied but tests broke. EMPTY_DIFF: no changes in scope."
    },
    "summary": {
      "type": "object",
      "required": ["total", "fixed", "skipped", "userReviewRequired", "deferred", "testsPass"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "fixed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "userReviewRequired": { "type": "integer", "minimum": 0 },
        "deferred": { "type": "integer", "minimum": 0 },
        "dismissed": { "type": "integer", "minimum": 0 },
        "testsPass": { "type": "boolean" }
      }
    },
    "normalizedItem": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["fixed", "skipped", "userReviewRequired", "deferred"] },
        "notes": { "type": "string" }
      }
    },
    "workflowItem": {
      "type": "object",
      "required": ["id", "file", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "severity": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "fixSummary": { "type": "string" },
        "filesModified": { "type": "array", "items": { "type": "string" } },
        "testsAdded": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "skipReason": { "type": "string" },
        "votes": { "type": "object" }
      }
    },
    "normalizedArtifact": {
      "type": "object",
      "required": ["status", "summary", "items"],
      "properties": {
        "status": { "$ref": "#/definitions/status" },
        "summary": { "$ref": "#/definitions/summary" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/normalizedItem" }
        }
      }
    },
    "workflowReturn": {
      "type": "object",
      "required": ["status", "reportPath", "testsPass", "counts", "applied", "userReviewRequired", "deferred", "skipped"],
      "properties": {
        "status": { "$ref": "#/definitions/status" },
        "reportPath": { "type": "string", "minLength": 1 },
        "testsPass": { "type": "boolean" },
        "counts": {
          "type": "object",
          "required": ["totalReviewed", "applied", "skipped", "userReviewRequired", "deferred", "dismissed"],
          "properties": {
            "totalReviewed": { "type": "integer", "minimum": 0 },
            "applied": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "userReviewRequired": { "type": "integer", "minimum": 0 },
            "deferred": { "type": "integer", "minimum": 0 },
            "dismissed": { "type": "integer", "minimum": 0 }
          }
        },
        "applied": {
          "type": "array",
          "items": { "$ref": "#/definitions/workflowItem" }
        },
        "userReviewRequired": {
          "type": "array",
          "items": { "$ref": "#/definitions/workflowItem" }
        },
        "deferred": {
          "type": "array",
          "items": { "$ref": "#/definitions/workflowItem" }
        },
        "skipped": {
          "type": "array",
          "items": { "$ref": "#/definitions/workflowItem" }
        }
      }
    },
    "emptyDiffReturn": {
      "type": "object",
      "required": ["status", "reviewed", "applied"],
      "properties": {
        "status": { "type": "string", "enum": ["EMPTY_DIFF"] },
        "reviewed": { "type": "integer", "minimum": 0 },
        "applied": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$comment": "Impossible-state guards (validated in JS, not expressible cleanly in JSON Schema): READY_FOR_COMMIT requires testsPass=true and skipped/userReviewRequired/deferred all 0; REQUIRES_USER_REVIEW requires userReviewRequired>0 or skipped>0; REQUIRES_FOLLOW_UP requires deferred>0, userReviewRequired=0, skipped=0, and NOT (fixed>0 && testsPass=false) — workflow precedence (!testsPass && applied>0 → TESTS_FAILED) fires before deferred check; TESTS_FAILED requires testsPass=false and fixed>0; CLEAN requires fixed/skipped/userReviewRequired/deferred all 0 and may only include dismissed findings in total; EMPTY_DIFF requires total/fixed/skipped/userReviewRequired/deferred all 0."
}
