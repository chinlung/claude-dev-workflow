{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "code-audit-finding",
  "title": "Code Audit Finding",
  "description": "A single finding from a code audit review.",
  "type": "object",
  "required": ["id", "title", "severity", "confidence", "ev", "decision", "description", "crossReferences"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "ev": { "type": "number" },
    "decision": { "type": "string", "enum": ["FIX", "SKIP", "DEFER", "USER_REVIEW"] },
    "description": { "type": "string", "minLength": 1 },
    "crossReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "lines", "quotedCode", "note"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "lines": { "type": "string", "minLength": 1 },
          "quotedCode": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["stride", "cwe"],
      "properties": {
        "stride": { "type": "string", "enum": ["S", "T", "R", "I", "D", "E"] },
        "cwe": { "type": "string", "pattern": "^CWE-[0-9]+$" }
      }
    }
  }
}
